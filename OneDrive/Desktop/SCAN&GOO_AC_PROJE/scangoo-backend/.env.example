# ─────────────────────────────────────────────
# SCAN&GOO  –  Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=scangoo

# JWT
JWT_SECRET=scangoo_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Admin seed credentials (used by db:init only)
ADMIN_PHONE=+250788000001
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin Inzovu

# Demo shopper seed credentials
DEMO_PHONE=+250788123456
DEMO_PASSWORD=password123
DEMO_NAME=Amahoro Jean
